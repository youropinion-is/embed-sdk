{
  "name": "@youropinion/embed",
  "version": "0.2.1",
  "type": "module",
  "description": "Embed YouOpinion surveys on any website. Surfaces: Widget, Dialog, Drawer, Popover. Triggers: Feedback Tab, Chat Bubble.",
  "license": "MIT",
  "main": "dist/embed.umd.js",
  "module": "dist/embed.esm.js",
  "types": "dist/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.esm.js",
      "require": "./dist/embed.umd.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.js"
    },
    "./css": "./dist/embed.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/youropinion-is/embed-sdk.git"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "test": "node --import tsx --import global-jsdom/register --test 'tests/**/*.test.ts'",
    "prepublishOnly": "pnpm run build",
    "ci:publish": "changeset tag && pnpm publish"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "global-jsdom": "29.0.0",
    "jsdom": "29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "youropinion",
    "survey",
    "embed",
    "form",
    "widget",
    "popup",
    "feedback",
    "iframe"
  ],
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
